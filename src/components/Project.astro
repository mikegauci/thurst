---
interface Props { title: string; category: string; video: string; embedTitle: string }
const { title, category, video, embedTitle } = Astro.props;
---
<article class="project">
  <div class="project-video">
    <iframe
      src={`https://player.vimeo.com/video/${video}${video.includes('?') ? '&' : '?'}dnt=1&app_id=122963`}
      title={embedTitle}
      loading="lazy"
      allow="autoplay; fullscreen; picture-in-picture"
      allowfullscreen
    ></iframe>
  </div>
  <div class="project-caption">
    <h3>{title}</h3>
    <p>{category}</p>
  </div>
</article>
